# Security headers for every page and Function response served by Cloudflare Pages.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin

# Pages whose address carries a registration token: never send it on as a referrer, never cache.
/events/confirm/*
  Referrer-Policy: no-referrer
  Cache-Control: no-store
/events/manage/*
  Referrer-Policy: no-referrer
  Cache-Control: no-store
/admin/*
  Referrer-Policy: no-referrer
  Cache-Control: no-store

# The link-page map's physics, also loaded by the editor's sandboxed preview (an opaque origin).
/link-assets/*
  Access-Control-Allow-Origin: *
  Cache-Control: no-cache

# The link-page editor: sign-in links carry their token after #; keep it out of referrers and caches.
/links/edit/*
  Referrer-Policy: no-referrer
  Cache-Control: no-store
