---
/** Privacy-friendly YouTube embed (youtube-nocookie.com, lazy-loaded). */
interface Props {
	id: string;
	title?: string;
}
const { id, title = 'YouTube video' } = Astro.props;
---
<div class="video-embed">
	<iframe
		src={`https://www.youtube-nocookie.com/embed/${id}`}
		title={title}
		loading="lazy"
		allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
		allowfullscreen
	></iframe>
</div>
<style>
	.video-embed { position: relative; aspect-ratio: 16 / 9; width: 100%; margin-block: 1.5rem; }
	.video-embed iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; border-radius: 0.5rem; }
</style>
