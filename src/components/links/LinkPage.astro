---
// A link-in-bio page (amy.bo/~<handle>). Every link goes through /~<handle>/go/<slug>, which counts the click.
import { siPatreon, siYoutube, siLinktree, siX, siMastodon, siZotero, siGithub } from 'simple-icons';
import type { IconKey, LinkPage } from '../../links/types';
import logo from '../../assets/amybo.svg';

import { Image } from 'astro:assets';

interface Props { page: LinkPage; photo?: ImageMetadata; mark?: ImageMetadata }
const { page, photo, mark } = Astro.props;

const brand: Partial<Record<IconKey, { path: string; hex: string }>> = {
	patreon: siPatreon, youtube: siYoutube, linktree: siLinktree, x: siX, mastodon: siMastodon, zotero: siZotero, github: siGithub,
};
// Simple line icons (24×24, stroked) for links without a brand mark.
const line: Partial<Record<IconKey, string>> = {
	software: '<rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4M8 9l-2 2 2 2M16 9l2 2-2 2"/>',
	camera: '<path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/>',
	water: '<path d="M12 3s6 7 6 11a6 6 0 0 1-12 0c0-4 6-11 6-11z"/><path d="M9 15a3 3 0 0 0 3 3"/>',
	cv: '<path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5M9 12h7M9 16h7"/>',
	music: '<path d="M9 18V5l11-2v13"/><circle cx="6.5" cy="18" r="2.5"/><circle cx="17.5" cy="16" r="2.5"/>',
	gift: '<rect x="3" y="8" width="18" height="4" rx="1"/><path d="M5 12v9h14v-9M12 8v13M12 8S10 3 7.5 4.5 9 8 12 8zM12 8s2-5 4.5-3.5S15 8 12 8z"/>',
	radio: '<path d="M12 12v9M8 21h8"/><circle cx="12" cy="10" r="2"/><path d="M8.5 6.5a5 5 0 0 0 0 7M15.5 6.5a5 5 0 0 1 0 7M5.5 3.5a9 9 0 0 0 0 13M18.5 3.5a9 9 0 0 1 0 13"/>',
	mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>',
	forum: '<path d="M4 5h12v8H9l-4 3v-3H4z"/><path d="M16 9h4v8h-1v3l-4-3h-4v-4"/>',
	docs: '<path d="M4 5a2 2 0 0 1 2-2h13v15H6a2 2 0 0 0-2 2z"/><path d="M4 20a2 2 0 0 0 2 1h13v-3M8 7h7M8 11h5"/>',
	print: '<path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M4 7.5l8 4.5 8-4.5M12 12v9"/>',
	person: '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
	link: '<path d="M10 14a4 4 0 0 0 6 0l3-3a4 4 0 0 0-6-6l-1 1M14 10a4 4 0 0 0-6 0l-3 3a4 4 0 0 0 6 6l1-1"/>',
};
const host = (u: string) => new URL(u).hostname.replace(/^www\./, '') + new URL(u).pathname.replace(/\/$/, '');
const initials = page.name.split(/\s+/).map((w) => w[0]).join('').slice(0, 2);
const title = page.name;
const description = page.bio ?? `${page.name}'s links: ${page.sections.filter((s) => s.title).map((s) => s.title!.split(' - ')[0]).join(', ')}.`;
---
<!doctype html>
<html lang="en-GB">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{title}</title>
	<meta name="description" content={description} />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta property="og:url" content={`https://amy.bo/~${page.handle}`} />
	<link rel="canonical" href={`https://amy.bo/~${page.handle}`} />
	<link rel="icon" href="/favicon.svg" />
	{page.rel?.map((href) => <link rel="me" href={href} />)}
	<meta name="color-scheme" content="light dark" />
</head>
<body>
	<main>
		<header>
			{mark ? (
				<img class="mark" src={mark.src} alt={page.name} width="180" height={Math.round((180 * mark.height) / mark.width)} />
			) : photo ? (
				<Image class="avatar photo" src={photo} alt="" width={192} height={192} densities={[1, 2]} loading="eager" />
			) : (
				<div class="avatar" aria-hidden="true">{initials}</div>
			)}
			<h1 class:list={[{ 'visually-hidden': !!mark }]}>{page.name}</h1>
			{page.bio && <p class="bio">{page.bio}</p>}
		</header>
		{page.sections.map((s) => (
			<section>
				{s.title && <h2>{s.title}</h2>}
				<ul>
					{s.links.map((l) => (
						<li>
							<a href={`/~${page.handle}/go/${l.slug}`} rel={page.rel?.includes(l.url) ? 'me' : undefined}>
								<span class="icon" style={brand[l.icon!] ? `--brand:#${brand[l.icon!]!.hex}` : undefined}>
									{l.icon === 'amybo' ? (
										<img src={logo.src} alt="" width="28" height="19" />
									) : l.icon === 'linkedin' ? (
										<svg viewBox="0 0 24 24" aria-hidden="true"><text x="12" y="17" text-anchor="middle" font-family="Arial, sans-serif" font-weight="700" font-size="15" fill="currentColor">in</text></svg>
									) : brand[l.icon!] ? (
										<svg viewBox="0 0 24 24" aria-hidden="true" class="brand"><path d={brand[l.icon!]!.path} /></svg>
									) : (
										<svg viewBox="0 0 24 24" aria-hidden="true" class="line" set:html={line[l.icon ?? 'link'] ?? line.link} />
									)}
								</span>
								<span class="text">
									<span class="label">{l.label}</span>
									<span class="host">{host(l.url).startsWith('contact.andeye.com') ? 'Contact form' : host(l.url)}</span>
								</span>
								<svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
							</a>
						</li>
					))}
				</ul>
			</section>
		))}
		<footer>
			<a href="https://amybo.org/">amy.bo</a> · clicks are counted, nothing about you is stored · <a href="https://amybo.org/privacy/">privacy</a>
		</footer>
	</main>
</body>
</html>

<style is:global>
	:root {
		--bg: #f3f7ef;
		--bg2: #e4efdb;
		--card: #ffffff;
		--ink: #14210f;
		--muted: #5b6b54;
		--line: #dbe5d3;
		--accent: #43a500;
		--accent-ink: #175a00;
		--tile: #eef5e8;
		--shadow: 0 1px 2px rgb(20 33 15 / 6%), 0 4px 14px rgb(20 33 15 / 6%);
	}
	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #0d1509;
			--bg2: #13210d;
			--card: #172312;
			--ink: #e8f2e2;
			--muted: #9fb196;
			--line: #263a1e;
			--accent: #87bd25;
			--accent-ink: #b5e07a;
			--tile: #20321a;
			--shadow: 0 1px 2px rgb(0 0 0 / 30%);
		}
	}
	* { box-sizing: border-box; }
	html { background: var(--bg); }
	body {
		margin: 0;
		min-height: 100vh;
		font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
		color: var(--ink);
		background: radial-gradient(60rem 30rem at 50% -10rem, var(--bg2), transparent 70%), var(--bg);
		-webkit-font-smoothing: antialiased;
	}
	main { max-width: 34rem; margin: 0 auto; padding: 3rem 1rem 2rem; }
	header { text-align: center; margin-bottom: 1.5rem; }
	.avatar {
		width: 6rem; height: 6rem; margin: 0 auto 1rem; border-radius: 50%;
		display: grid; place-items: center;
		font-size: 2rem; font-weight: 700; letter-spacing: .02em; color: #fff;
		background: linear-gradient(135deg, #87bd25, #175a00);
		box-shadow: 0 0 0 4px var(--card), var(--shadow);
	}
	.avatar.photo { display: block; width: 6rem; height: 6rem; object-fit: cover; background: var(--card); }
	.mark { display: block; width: 11rem; height: auto; margin: 0 auto 1rem; }
	@media (prefers-color-scheme: dark) { .mark { filter: brightness(1.6); } }
	.visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
	.bio { margin: .5rem auto 0; max-width: 26rem; color: var(--muted); line-height: 1.45; text-wrap: balance; }
	h1 { font-size: 1.6rem; margin: 0; letter-spacing: -.01em; }
	h2 {
		font-size: .78rem; font-weight: 650; text-transform: uppercase; letter-spacing: .08em;
		color: var(--muted); margin: 1.75rem .25rem .6rem;
	}
	ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .6rem; }
	li a {
		display: flex; align-items: center; gap: .9rem;
		padding: .7rem .9rem .7rem .7rem;
		background: var(--card); border: 1px solid var(--line); border-radius: 1rem;
		color: inherit; text-decoration: none; box-shadow: var(--shadow);
		transition: transform .15s ease, border-color .15s ease, box-shadow .15s ease;
	}
	li a:hover { transform: translateY(-1px); border-color: var(--accent); }
	li a:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
	.icon {
		flex: none; width: 2.6rem; height: 2.6rem; border-radius: .75rem;
		display: grid; place-items: center; background: var(--tile); color: var(--accent-ink);
	}
	.icon svg { width: 1.35rem; height: 1.35rem; }
	.icon svg.brand { fill: var(--brand, currentColor); }
	.icon svg.line { fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
	.icon img { width: 1.9rem; height: auto; }
	@media (prefers-color-scheme: dark) {
		.icon svg.brand { fill: currentColor; }
		.icon img { filter: brightness(1.6); }
	}
	.text { flex: 1; min-width: 0; display: grid; }
	.label { font-weight: 600; line-height: 1.3; }
	.host { font-size: .82rem; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.chev { flex: none; width: 1.1rem; height: 1.1rem; fill: none; stroke: var(--muted); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
	footer { margin-top: 2.5rem; text-align: center; font-size: .8rem; color: var(--muted); }
	footer a { color: inherit; }
	@media (prefers-reduced-motion: reduce) { li a { transition: none; } li a:hover { transform: none; } }
</style>
