---
// Latest threads from forum.amybo.org, fetched at build time. Renders nothing if the forum could not be reached.
import { getLatestThreads, describe } from '../lib/forum.mjs';
const { limit = 6 } = Astro.props;
const threads = await getLatestThreads({ limit });
---
{threads.length > 0 && (
	<div class="forum-latest not-content">
		<p class="forum-latest-heading">Latest on the forum</p>
		<ul>
			{threads.map((t) => (
				<li>
					<a href={t.url}>{t.title}</a>
					<span class="meta">{describe(t)}</span>
				</li>
			))}
		</ul>
	</div>
)}
<style>
	.forum-latest { margin: 1.5rem 0; padding: 1rem 1.25rem; border: 1px solid var(--sl-color-gray-5); border-radius: 0.5rem; background: var(--sl-color-bg-nav); }
	.forum-latest-heading { margin: 0 0 0.5rem; font-weight: 600; color: var(--sl-color-white); }
	.forum-latest ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.4rem; }
	.forum-latest li { display: flex; flex-wrap: wrap; gap: 0.25rem 0.75rem; align-items: baseline; }
	.forum-latest a { color: var(--sl-color-text-accent); }
	.forum-latest .meta { font-size: var(--sl-text-sm); color: var(--sl-color-gray-3); }
</style>
