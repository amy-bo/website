---
/**
 * A statement (the strapline or the mission statement) with its bullet list. Each <span data-term> in the statement is
 * paired, in order, with the list item at the same position: hovering either one highlights both.
 * Without JavaScript it is just the statement and the list.
 */
---
<div class="mission"><slot /></div>
<script>
	document.querySelectorAll<HTMLElement>('.mission').forEach((box) => {
		const terms = [...box.querySelectorAll<HTMLElement>('[data-term]')];
		const items = [...box.querySelectorAll<HTMLElement>(':scope > ul > li')];
		terms.forEach((term, i) => {
			const item = items[i];
			if (!item) return;
			const on = () => { term.classList.add('lit'); item.classList.add('lit'); };
			const off = () => { term.classList.remove('lit'); item.classList.remove('lit'); };
			for (const el of [term, item]) {
				el.addEventListener('mouseenter', on);
				el.addEventListener('mouseleave', off);
			}
		});
	});
</script>
<style>
	.mission :global([data-term]) { text-decoration: underline dotted var(--sl-color-accent); text-underline-offset: 0.2em; border-radius: 0.2rem; cursor: default; }
	.mission :global(li) { border-radius: 0.3rem; padding-inline: 0.3rem; margin-inline-start: -0.3rem; }
	/* Hovering a term or its bullet outlines both in brand green. An outline, not a background: a green background
	   swallowed the green "All" and hid the blue of the links. */
	.mission :global(.lit) { outline: 2px solid #87bd25; outline-offset: 2px; }
	/* The strapline in the brand colours: "Sustainable Protein for" in blue #007CBB (4.5:1 on white and black; large text, so it also passes
	   on the dark theme); "All" in green #87BD25 on the dark theme, and in the dark green #5C8119 on light (4.6:1 on
	   white), since the brand green itself is 1.9:1 on white and would be illegible as text. */
	.mission :global(.strapline [data-term]) { text-decoration: none; }
	.mission :global(.strapline) { margin: 0; color: #007cbb; font-size: var(--sl-text-2xl); font-weight: 700; line-height: 1.3; }
	.mission :global(.strapline .brand-green) { color: #87bd25; }
	:global([data-theme='light']) .mission :global(.strapline .brand-green) { color: #5c8119; }
</style>
