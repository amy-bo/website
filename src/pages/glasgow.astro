---
// Live lecture polling: the students' page. Static; it polls /api/glasgow/state and shows whichever question the
// presenter's slide has opened. Anonymous: a random device id kept in this browser, nothing else.
import { ACTIVE_SET, findSet } from '../glasgow/sets';
const set = findSet(ACTIVE_SET)!;
---
<!doctype html>
<html lang="en-GB">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
	<title>{set.title} · live questions · AMYBO</title>
	<meta name="description" content="Answer the lecture's live questions. Anonymous answers, shown live in the lecture." />
	<meta name="robots" content="noindex" />
	<meta name="color-scheme" content="light" />
	<meta name="theme-color" content="#ffffff" />
	<link rel="icon" href="/favicon.svg" />
	<link rel="preload" href="/fonts/Montserrat-SemiBold.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
	<main id="app" data-set={set.id} data-poll={set.pollSeconds}>
		<header>
			<img src="/link-media/amybo.svg" alt="AMYBO" width="96" height="66" />
			{set.logo ? <img class="lecture-logo" src={set.logo.src} alt={set.logo.alt} width="440" height="206" /> : <p class="lecture">{set.title}</p>}
		</header>

		<section id="waiting" aria-live="polite">
			<h1>Live questions</h1>
			<p id="waiting-text">Keep this page open: the next question appears here when the lecture reaches it.</p>
		</section>

		<form id="question" hidden novalidate>
			<h1 id="prompt" tabindex="-1"></h1>
			<div id="number-box" hidden>
				<output id="number-out" for="number-range" aria-live="polite"></output>
				<input id="number-range" type="range" aria-labelledby="prompt" />
				<div class="ends" aria-hidden="true"><span id="range-min"></span><span id="range-max"></span></div>
				<label class="exact" for="number-input">Or type it exactly <input id="number-input" type="number" inputmode="decimal" /><span id="number-unit"></span></label>
			</div>
			<div id="choice-box" hidden role="group" aria-labelledby="prompt"></div>
			<div id="text-box" hidden>
				<label for="text-input" class="vh">Your answer</label>
				<input id="text-input" type="text" autocomplete="off" enterkeyhint="send" />
				<p class="count" id="text-count" aria-live="polite"></p>
				<ul id="mine" hidden></ul>
			</div>
			<button id="send" type="submit">Send</button>
			<p id="status" role="status"></p>
		</form>

		<section id="audience" aria-labelledby="ask-h">
			<button id="hand" type="button" aria-pressed="false">✋ Hand up</button>
			<form id="ask" novalidate>
				<h2 id="ask-h"><label for="ask-text">Ask a question or comment</label></h2>
				<textarea id="ask-text" rows="3" maxlength="500"></textarea>
				<p class="count" id="ask-count" aria-live="polite">0 of 500</p>
				<button id="ask-send" type="submit">Send</button>
				<p id="ask-status" role="status"></p>
				<details id="asked-box" hidden><summary>What you have sent from this phone</summary><ul id="asked"></ul></details>
			</form>
		</section>

		<p class="notice">Anonymous answers, shown live in the lecture. Questions and comments go to the presenter only. <a href="/privacy/#live-lecture-questions">Privacy</a></p>
		<noscript><p>This page needs JavaScript to show the questions.</p></noscript>
	</main>

	<script>
		type Q = { id: string; type: 'number' | 'text' | 'choice'; options?: string[]; prompt: string; min?: number; max?: number; step?: number; scale?: 'linear' | 'log'; unit?: string; maxLength?: number; multiple?: boolean };
		type State = { set: string; current: string | null; pollSeconds: number; questions: Q[] };
		const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
		const app = $('app'), setId = app.dataset.set || '';
		let every = Math.max(1, Number(app.dataset.poll) || 2) * 1000;

		// A random id, made here and kept here, so each phone answers once per question and can change its answer.
		const store = (() => { try { const k = '__t'; localStorage.setItem(k, k); localStorage.removeItem(k); return localStorage; } catch { return null; } })();
		const memory: Record<string, string> = {};
		const get = (k: string) => (store ? store.getItem(k) : memory[k] ?? null);
		const put = (k: string, v: string) => { try { store ? store.setItem(k, v) : (memory[k] = v); } catch { memory[k] = v; } };
		let device = get('glasgow-device');
		if (!device || !/^[A-Za-z0-9_-]{16,64}$/.test(device)) {
			const b = crypto.getRandomValues(new Uint8Array(18));
			device = btoa(String.fromCharCode(...b)).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
			put('glasgow-device', device);
		}
		const sentKey = (q: string) => `glasgow-${setId}-${q}`;

		const form = $<HTMLFormElement>('question'), waiting = $('waiting'), status = $('status'), prompt = $('prompt');
		const numBox = $('number-box'), range = $<HTMLInputElement>('number-range'), exact = $<HTMLInputElement>('number-input'), out = $<HTMLOutputElement>('number-out');
		const choiceBox = $('choice-box');
		const textBox = $('text-box'), text = $<HTMLInputElement>('text-input'), count = $('text-count'), send = $<HTMLButtonElement>('send');
		let shown: Q | null = null;
		let sending = false;

		const decimals = (q: Q) => Math.max(0, -Math.floor(Math.log10(q.step || 1) + 1e-9));
		// A log slider runs over log10 of the value; 0 sits at the slider's left end (0.01 %, say, is close enough to none).
		const LOG_STEPS = 1000;
		const logMin = (q: Q) => Math.max(q.step || 0.01, q.min || 0) || 0.01;
		const fromSlider = (q: Q, s: number) => {
			if (q.scale !== 'log') return s;
			if (s <= 0) return q.min ?? 0;
			const lo = Math.log10(logMin(q)), hi = Math.log10(q.max ?? 10);
			return Number((10 ** (lo + (hi - lo) * (s / LOG_STEPS))).toPrecision(2));
		};
		const toSlider = (q: Q, v: number) => {
			if (q.scale !== 'log') return v;
			if (v <= logMin(q) / 2) return 0;
			const lo = Math.log10(logMin(q)), hi = Math.log10(q.max ?? 10);
			return Math.round(((Math.log10(Math.min(Math.max(v, logMin(q)), q.max ?? 10)) - lo) / (hi - lo)) * LOG_STEPS);
		};
		const fmt = (q: Q, v: number) => {
			// A log scale shows two significant figures, so 0.00037 % reads as such; a linear one, the step's decimals.
			const n = q.scale === 'log' ? (v >= 10 ? Number(v.toFixed(0)) : Number(v.toPrecision(2))) : Number(v.toFixed(decimals(q)));
			const s = Math.abs(n) > 0 && Math.abs(n) < 0.001 ? n.toFixed(-Math.floor(Math.log10(Math.abs(n))) + 1).replace(/0+$/, '') : String(n);
			return `${s}${q.unit === '%' ? '%' : q.unit ? ' ' + q.unit : ''}`;
		};
		let numberValue = 0;
		const setNumber = (q: Q, v: number, from: 'range' | 'exact' | 'init') => {
			numberValue = v;
			out.textContent = fmt(q, v);
			if (from !== 'range') range.value = String(toSlider(q, v));
			if (from !== 'exact') exact.value = String(v);
		};

		// A word-cloud question keeps a list of what this phone has added, so students can see what they sent.
		const added = (q: Q): string[] => { try { return JSON.parse(get(sentKey(q.id) + '-list') || '[]'); } catch { return []; } };
		const mine = $('mine');
		function showMine(q: Q) {
			const list = q.multiple ? added(q) : [];
			mine.hidden = !list.length;
			mine.replaceChildren(...list.map((t) => { const li = document.createElement('li'); li.textContent = t; return li; }));
		}

		// Yes / No / Don't know get their own colours, the same as the lecture slide's result bars; any other option is blue-outlined.
		function choiceTone(label: string) {
			const k = label.toLowerCase().replace(/[’'`.!?]/g, '').replace(/\s+/g, ' ').trim();
			return k === 'yes' ? 'tone-yes' : k === 'no' ? 'tone-no' : k === 'dont know' || k === 'do not know' ? 'tone-dk' : '';
		}

		function show(q: Q | null) {
			// Redrawn only when the question changes, or the presenter edits it while it is showing.
			if (shown && q && JSON.stringify(shown) === JSON.stringify(q)) return;
			shown = q;
			status.textContent = '';
			if (!q) { form.hidden = true; waiting.hidden = false; return; }
			waiting.hidden = true; form.hidden = false;
			prompt.textContent = q.prompt;
			const previous = get(sentKey(q.id));
			numBox.hidden = q.type !== 'number'; textBox.hidden = q.type !== 'text'; choiceBox.hidden = q.type !== 'choice';
			send.hidden = q.type === 'choice';
			if (q.type === 'choice') {
				// One big button per option: a tap sends it; the chosen one stays marked, and another tap changes it.
				choiceBox.replaceChildren(...(q.options || []).map((label, i) => {
					const b = document.createElement('button');
					b.type = 'button'; b.className = `choice ${choiceTone(label)}`; b.textContent = label;
					b.setAttribute('aria-pressed', String(previous === String(i)));
					b.addEventListener('click', () => sendAnswer(q, i));
					return b;
				}));
			}
			if (q.type === 'number') {
				const log = q.scale === 'log';
				range.min = log ? '0' : String(q.min); range.max = log ? String(LOG_STEPS) : String(q.max); range.step = log ? '1' : String(q.step);
				exact.min = String(q.min); exact.max = String(q.max); exact.step = String(q.step);
				$('range-min').textContent = log ? `${q.min}${q.unit === '%' ? '%' : ''}` : fmt(q, q.min!);
				$('range-max').textContent = fmt(q, q.max!);
				$('number-unit').textContent = q.unit || '';
				const start = previous !== null ? Number(previous) : log ? 1 : Number((((q.min ?? 0) + (q.max ?? 0)) / 2).toFixed(decimals(q)));
				setNumber(q, start, 'init');
			} else {
				text.maxLength = q.maxLength || 80;
				text.value = q.multiple ? '' : previous ?? '';
				count.textContent = `${[...text.value].length} of ${text.maxLength}`;
			}
			showMine(q);
			if (q.type === 'choice') {
				if (previous !== null) status.textContent = 'Your answer is in. Tap another to change it.';
			} else if (q.multiple) {
				send.textContent = 'Add';
				if (added(q).length) status.textContent = 'Add as many as you like, one at a time.';
			} else {
				send.textContent = previous !== null ? 'Change my answer' : 'Send';
				if (previous !== null) status.textContent = 'Your answer is in. You can change it.';
			}
			prompt.focus({ preventScroll: true });
		}

		range.addEventListener('input', () => shown && setNumber(shown, fromSlider(shown, Number(range.value)), 'range'));
		exact.addEventListener('input', () => { if (shown && exact.value !== '' && Number.isFinite(Number(exact.value))) setNumber(shown, Number(exact.value), 'exact'); });
		text.addEventListener('input', () => { count.textContent = `${[...text.value].length} of ${text.maxLength}`; });

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const q = shown;
			if (!q || sending || q.type === 'choice') return;
			let value: number | string;
			if (q.type === 'number') {
				value = numberValue;
				if (!Number.isFinite(value) || value < (q.min ?? -Infinity) || value > (q.max ?? Infinity)) { status.textContent = `Please give a number from ${q.min} to ${q.max}.`; return; }
			} else {
				value = text.value.trim();
				if (!value) { status.textContent = 'Please type an answer.'; text.focus(); return; }
			}
			await sendAnswer(q, value);
		});

		async function sendAnswer(q: Q, value: number | string) {
			if (sending) return;
			sending = true; send.disabled = true; status.textContent = 'Sending…';
			try {
				const res = await fetch('/api/glasgow/answer', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ set: setId, q: q.id, value, device }) });
				const body = await res.json().catch(() => ({}));
				if (res.ok && q.multiple) {
					put(sentKey(q.id) + '-list', JSON.stringify([...added(q), String(body.value ?? value)]));
					text.value = ''; count.textContent = `0 of ${text.maxLength}`;
					showMine(q);
					status.textContent = 'Added. Add another, or wait for the next question.';
					text.focus();
				} else if (res.ok && q.type === 'choice') {
					put(sentKey(q.id), String(value));
					choiceBox.querySelectorAll('button').forEach((b, i) => b.setAttribute('aria-pressed', String(i === value)));
					status.textContent = `Thank you: “${q.options?.[value as number]}” is in. Tap another to change it.`;
				} else if (res.ok) {
					put(sentKey(q.id), String(body.value ?? value));
					send.textContent = 'Change my answer';
					status.textContent = 'Thank you: your answer is in. You can change it.';
				} else if (res.status === 409) {
					status.textContent = 'That question has just closed.';
					tick();
				} else status.textContent = body.error || 'That did not go through: please try again.';
			} catch {
				status.textContent = 'No connection just now: please try again.';
			} finally { sending = false; send.disabled = false; }
		}

		let timer = 0;
		async function tick() {
			clearTimeout(timer);
			try {
				const res = await fetch(`/api/glasgow/state?set=${encodeURIComponent(setId)}`, { cache: 'no-store' });
				if (res.ok) {
					const s = await res.json() as State;
					every = Math.max(1, Number(s.pollSeconds) || 2) * 1000;
					show(s.questions.find((q) => q.id === s.current) ?? null);
					$('waiting-text').textContent = 'Keep this page open: the next question appears here when the lecture reaches it.';
				}
			} catch {
				if (!shown) $('waiting-text').textContent = 'Trying to connect…';
			}
			if (!document.hidden) timer = window.setTimeout(tick, every);
		}
		document.addEventListener('visibilitychange', () => { if (!document.hidden) tick(); else clearTimeout(timer); });
		tick();

		// Hand up: shown to the presenter while this phone keeps re-sending it (every minute); after three minutes
		// without, the server counts it as lowered, so a phone that has gone away does not leave a hand up.
		const hand = $<HTMLButtonElement>('hand'), handKey = `glasgow-${setId}-hand`;
		let handUp = false, handTimer = 0;
		const drawHand = () => { hand.setAttribute('aria-pressed', String(handUp)); hand.textContent = handUp ? '✋ Hand is up, tap to lower' : '✋ Hand up'; hand.classList.toggle('up', handUp); };
		async function sendHand(up: boolean) {
			const res = await fetch('/api/glasgow/hand', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ set: setId, device, up }) });
			if (!res.ok) throw new Error(String(res.status));
		}
		function keepHand() {
			clearInterval(handTimer);
			if (handUp) handTimer = window.setInterval(() => { sendHand(true).then(() => put(handKey, String(Date.now()))).catch(() => {}); }, 60_000);
		}
		hand.addEventListener('click', async () => {
			const want = !handUp;
			hand.disabled = true;
			try {
				await sendHand(want);
				handUp = want; put(handKey, want ? String(Date.now()) : '');
			} catch { $('ask-status').textContent = 'No connection just now: please try again.'; }
			hand.disabled = false; drawHand(); keepHand();
		});
		{ const at = Number(get(handKey) || 0); if (at && Date.now() - at < 170_000) { handUp = true; sendHand(true).catch(() => {}); } drawHand(); keepHand(); }

		// Questions and comments: as many as anyone likes; this phone keeps a list of what it sent.
		const ask = $<HTMLFormElement>('ask'), askText = $<HTMLTextAreaElement>('ask-text'), askStatus = $('ask-status'), askSend = $<HTMLButtonElement>('ask-send');
		const askedKey = `glasgow-${setId}-asked`;
		const asked = (): { text: string; at: string }[] => { try { return JSON.parse(get(askedKey) || '[]'); } catch { return []; } };
		function drawAsked() {
			const list = asked();
			$('asked-box').hidden = !list.length;
			$('asked').replaceChildren(...list.slice().reverse().map((x) => { const li = document.createElement('li'); li.textContent = x.text; return li; }));
		}
		askText.addEventListener('input', () => { $('ask-count').textContent = `${[...askText.value].length} of 500`; });
		ask.addEventListener('submit', async (e) => {
			e.preventDefault();
			const text = askText.value.trim();
			if (!text) { askStatus.textContent = 'Please type a question or comment.'; askText.focus(); return; }
			askSend.disabled = true; askStatus.textContent = 'Sending…';
			try {
				const res = await fetch('/api/glasgow/question', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ set: setId, device, text }) });
				const body = await res.json().catch(() => ({}));
				if (res.ok) {
					put(askedKey, JSON.stringify([...asked(), { text, at: new Date().toISOString() }]));
					askText.value = ''; $('ask-count').textContent = '0 of 500';
					askStatus.textContent = 'Sent to the presenter. Send another any time.';
					drawAsked();
				} else askStatus.textContent = body.error || 'That did not go through: please try again.';
			} catch { askStatus.textContent = 'No connection just now: please try again.'; }
			askSend.disabled = false;
		});
		drawAsked();
	</script>

	<style is:global>
		@font-face { font-family: 'Montserrat SemiBold'; src: url('/fonts/Montserrat-SemiBold.woff2') format('woff2'); font-weight: 1 1000; font-display: swap; }
		:root { color-scheme: light; --blue: #007cbb; --green: #87bd25; --ink: #111; --muted: #555; }
		* { box-sizing: border-box; }
		html { -webkit-text-size-adjust: 100%; }
		body { margin: 0; background: #fff; color: var(--ink); font: 18px/1.45 'Montserrat SemiBold', Montserrat, Arial, Helvetica, sans-serif; }
		main { max-width: 34rem; margin: 0 auto; padding: max(1rem, env(safe-area-inset-top)) 1rem max(1.5rem, env(safe-area-inset-bottom)); min-height: 100dvh; display: flex; flex-direction: column; gap: 1.25rem; }
		header { display: flex; align-items: center; justify-content: space-between; }
		header img { display: block; height: 2.6rem; width: auto; }
		header { gap: 1rem; }
		.lecture { margin: 0; color: var(--blue); font-size: 1.05rem; }
		h1 { font-size: 1.6rem; line-height: 1.25; margin: 0 0 0.75rem; outline: none; }
		#waiting p { color: var(--muted); margin: 0; }
		form { display: flex; flex-direction: column; gap: 1rem; }
		output { display: block; text-align: center; font-size: 3rem; line-height: 1.1; color: var(--blue); font-variant-numeric: tabular-nums; }
		input[type=range] { width: 100%; height: 2.75rem; accent-color: var(--blue); margin: 0; }
		.ends { display: flex; justify-content: space-between; color: var(--muted); font-size: 0.9rem; margin-top: -0.5rem; }
		.exact { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; color: var(--muted); font-size: 0.95rem; }
		.exact input { width: 6.5rem; font: inherit; color: var(--ink); padding: 0.4rem 0.5rem; border: 2px solid #8a8a8a; border-radius: 0.4rem; }
		#text-input { width: 100%; font: inherit; font-size: 1.2rem; padding: 0.75rem; border: 2px solid #8a8a8a; border-radius: 0.5rem; }
		input:focus-visible, textarea:focus-visible, summary:focus-visible, button:focus-visible, a:focus-visible { outline: 3px solid var(--blue); outline-offset: 2px; }
		.count { margin: 0.25rem 0 0; color: var(--muted); font-size: 0.9rem; text-align: right; }
		#mine { list-style: none; margin: 0.5rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
		#mine li { background: #eef6fb; color: var(--blue); border-radius: 1rem; padding: 0.2rem 0.7rem; font-size: 0.95rem; }
		button { font: inherit; font-size: 1.2rem; min-height: 3.25rem; border: 0; border-radius: 0.6rem; background: var(--blue); color: #fff; cursor: pointer; }
		button:disabled { opacity: 0.6; }
		#choice-box { display: flex; flex-direction: column; gap: 0.75rem; }
		.choice { background: #fff; color: var(--blue); border: 2px solid var(--blue); font-size: 1.3rem; min-height: 3.5rem; }
		.choice[aria-pressed="true"] { background: var(--blue); color: #fff; }
		.choice[aria-pressed="true"]::after { content: ' ✓'; }
		/* Yes orange-red, No blue, Don't know grey, white text at 24px (large text, so 3:1 contrast is enough; all pass). */
		.choice.tone-yes, .choice.tone-no, .choice.tone-dk { color: #fff; border: 0; min-height: 4.5rem; font-size: 1.5rem; }
		.choice.tone-yes { background: #e8590c; }
		.choice.tone-no { background: #1c64f2; }
		.choice.tone-dk { background: #6b7280; }
		/* The chosen one: a thick dark ring as well as the tick. (Not fading the others: that would fail contrast.) */
		.choice[class*="tone-"][aria-pressed="true"] { box-shadow: 0 0 0 4px #fff, 0 0 0 7px #111; }
		#status, #ask-status { min-height: 1.5em; margin: 0; }
		#audience { display: flex; flex-direction: column; gap: 1rem; border-top: 2px solid #e5e5e5; padding-top: 1.25rem; }
		#hand { background: #fff; color: var(--blue); border: 2px solid var(--blue); }
		#hand.up { background: var(--green); border-color: var(--green); color: #111; }
		#ask { display: flex; flex-direction: column; gap: 0.5rem; }
		#ask h2 { font-size: 1.2rem; margin: 0; }
		#ask-text { width: 100%; font: inherit; padding: 0.75rem; border: 2px solid #8a8a8a; border-radius: 0.5rem; resize: vertical; }
		#asked { margin: 0.5rem 0 0; padding-left: 1.2rem; color: var(--muted); }
		#asked li { margin: 0.25rem 0; white-space: pre-wrap; overflow-wrap: anywhere; }
		summary { cursor: pointer; color: var(--blue); }
		.notice { margin-top: auto; color: var(--muted); font-size: 0.9rem; }
		.notice a { color: var(--blue); }
		.vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
		[hidden] { display: none !important; }
	</style>
</body>
</html>
