---
// Live lecture polling: a backup results screen (amybo.org/glasgow/results). Read-only for the audience: the current
// question's live results, big enough to read from the back. With the presenter token (kept in this browser only) it
// also switches questions, stops voting and clears a poll, using the existing API; it adds no server logic.
import { ACTIVE_SET, findSet } from '../../glasgow/sets';
const set = findSet(ACTIVE_SET)!;
---
<!doctype html>
<html lang="en-GB">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
	<title>{set.title} · live results · AMYBO</title>
	<meta name="robots" content="noindex" />
	<meta name="color-scheme" content="light" />
	<link rel="icon" href="/favicon.svg" />
	<link rel="preload" href="/fonts/Montserrat-SemiBold.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
	<main id="app" data-set={set.id}>
		<header>
			<img src="/link-media/amybo.svg" alt="AMYBO" width="96" height="66" />
			<p class="join">Answer at <strong>amy.bo/glasgow</strong></p>
			{set.logo ? <img class="lecture-logo" src={set.logo.src} alt={set.logo.alt} width="440" height="206" /> : <p class="lecture">{set.title}</p>}
		</header>

		<section id="board" aria-live="polite" aria-atomic="false">
			<h1 id="q-prompt">Live results</h1>
			<p id="q-status" class="status">Connecting…</p>
			<div id="chart"></div>
		</section>

		<details id="presenter">
			<summary>Presenter</summary>
			<form id="token-form">
				<label for="token">Presenter token (kept in this browser only)</label>
				<div class="row"><input id="token" type="password" autocomplete="off" spellcheck="false" /><button type="submit">Use token</button></div>
				<p id="token-status" role="status"></p>
			</form>
			<div id="controls" hidden>
				<p class="hint">Tap a question to show it on the phones.</p>
				<ol id="q-list"></ol>
				<div class="row">
					<button id="stop" type="button" class="secondary">Stop voting</button>
					<button id="clear" type="button" class="danger">Clear this poll</button>
				</div>
				<p id="control-status" role="status"></p>
			</div>
		</details>
	</main>

	<script>
		type Q = { id: string; type: 'number' | 'text' | 'choice'; prompt: string; min?: number; max?: number; scale?: 'linear' | 'log'; unit?: string; options?: string[]; colors?: (string | null)[] };
		const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
		const setId = $('app').dataset.set || '';
		const api = (path: string) => `/api/glasgow/${path}${path.includes('?') ? '&' : '?'}set=${encodeURIComponent(setId)}`;
		const store = { get: (k: string) => { try { return localStorage.getItem(k); } catch { return null; } }, put: (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} } };
		const STORE_KEY = ['glasgow', 'presenter'].join('-');
		let token = store.get(STORE_KEY) || '';
		let questions: Q[] = [], current: string | null = null, lastDrawn = '';

		const el = (tag: string, cls = '', text = '') => { const e = document.createElement(tag); if (cls) e.className = cls; if (text) e.textContent = text; return e; };
		const svgEl = (tag: string, attrs: Record<string, string | number>) => { const e = document.createElementNS('http://www.w3.org/2000/svg', tag); for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v)); return e; };
		const tone = (label: string) => { const k = label.toLowerCase().replace(/[’'`.!?]/g, '').replace(/\s+/g, ' ').trim(); return k === 'yes' ? '#E8590C' : k === 'no' ? '#1C64F2' : k === 'dont know' || k === 'do not know' ? '#6B7280' : null; };
		const PALETTE = ['#007CBB', '#87BD25', '#7C3AED', '#0B6E4F', '#B45309', '#BE185D', '#0E7490', '#4D7C0F', '#9333EA', '#C2410C', '#1D4ED8', '#374151'];
		// White on the swatch wherever it reads as large text (3:1, the counts are at least 24 px), else near-black.
		const ink = (hex: string) => { const ch = (i: number) => { const v = parseInt(hex.slice(i, i + 2), 16) / 255; return v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4; }; const L = 0.2126 * ch(1) + 0.7152 * ch(3) + 0.0722 * ch(5); return 1.05 / (L + 0.05) >= 3 ? '#fff' : '#111'; };
		const fmt = (v: number) => (Math.abs(v) >= 10 ? String(Math.round(v * 10) / 10) : String(Number(v.toPrecision(2))));

		function drawChoice(q: Q, r: any) {
			const counts: number[] = r.counts || [], total = counts.reduce((a, b) => a + b, 0), top = Math.max(1, ...counts);
			const wrap = el('div', 'bars');
			(r.options || q.options || []).forEach((label: string, i: number) => {
				const colour = (r.colors || q.colors)?.[i] || tone(label) || PALETTE[i % PALETTE.length];
				const row = el('div', 'bar-row');
				row.append(el('span', 'bar-label', label));
				const track = el('div', 'bar-track'), fill = el('div', 'bar-fill');
				fill.style.width = `${Math.max(counts[i] ? 8 : 0, (counts[i] / top) * 100)}%`;
				fill.style.background = colour;
				const n = el('span', 'bar-count', String(counts[i] ?? 0));
				n.style.background = colour; n.style.color = ink(colour);
				track.append(fill); row.append(track, n);
				wrap.append(row);
			});
			return { node: wrap, status: `${total} ${total === 1 ? 'answer' : 'answers'}` };
		}

		function drawNumber(q: Q, r: any) {
			const values: number[] = r.values || [], min = q.min ?? 0, max = q.max ?? 1, log = q.scale === 'log' && min > 0;
			const W = 1000, H = 270, pad = 70, base = 210;
			const x = (v: number) => pad + (W - 2 * pad) * (log ? (Math.log10(v) - Math.log10(min)) / (Math.log10(max) - Math.log10(min)) : (v - min) / (max - min));
			const svg = svgEl('svg', { viewBox: `0 0 ${W} ${H}`, class: 'dots', role: 'img', 'aria-label': `${values.length} answers${r.median !== null && r.median !== undefined ? `, median ${fmt(r.median)}${q.unit === '%' ? '%' : q.unit ? ' ' + q.unit : ''}` : ''}` });
			svg.append(svgEl('line', { x1: pad, x2: W - pad, y1: base, y2: base, stroke: '#111', 'stroke-width': 3 }));
			const ticks = log ? Array.from({ length: Math.round(Math.log10(max / min)) + 1 }, (_, i) => min * 10 ** i).filter((t) => t <= max * 1.0001) : Array.from({ length: 5 }, (_, i) => min + ((max - min) * i) / 4);
			for (const t of ticks) {
				svg.append(svgEl('line', { x1: x(t), x2: x(t), y1: base, y2: base + 12, stroke: '#111', 'stroke-width': 3 }));
				const lab = svgEl('text', { x: x(t), y: base + 44, 'text-anchor': 'middle', 'font-size': 28 }); lab.textContent = fmt(t) + (q.unit === '%' ? '%' : ''); svg.append(lab);
			}
			// Dots stacked upwards where answers fall close together.
			const stacks = new Map<number, number>();
			for (const v of values) {
				const cx = x(Math.min(max, Math.max(min, v))), key = Math.round(cx / 18), n = stacks.get(key) ?? 0;
				stacks.set(key, n + 1);
				svg.append(svgEl('circle', { cx, cy: base - 14 - n * 22, r: 10, fill: '#007CBB' }));
			}
			if (r.median !== null && r.median !== undefined) {
				const mx = x(r.median);
				svg.append(svgEl('line', { x1: mx, x2: mx, y1: 44, y2: base, stroke: '#87BD25', 'stroke-width': 6 }));
				const t = svgEl('text', { x: Math.min(W - 10, Math.max(10, mx)), y: 34, 'text-anchor': mx > W * 0.8 ? 'end' : mx < W * 0.2 ? 'start' : 'middle', 'font-size': 30, 'font-weight': 700 });
				t.textContent = `median ${fmt(r.median)}${q.unit === '%' ? '%' : q.unit ? ' ' + q.unit : ''}`; svg.append(t);
			}
			return { node: svg, status: `${values.length} ${values.length === 1 ? 'answer' : 'answers'}` };
		}

		function drawText(_q: Q, r: any) {
			const words: { text: string; n: number }[] = r.words || [], top = Math.max(1, ...words.map((w) => w.n));
			const cloud = el('ul', 'cloud');
			words.slice(0, 80).forEach((w, i) => {
				const li = el('li', '', w.text);
				li.style.fontSize = `${1.3 + 2.2 * (w.n / top)}rem`;
				li.style.color = PALETTE[i % PALETTE.length];
				if (w.n > 1) li.title = `${w.n} times`;
				cloud.append(li);
			});
			return { node: cloud, status: `${r.count ?? 0} ${r.count === 1 ? 'answer' : 'answers'}` };
		}

		async function refresh() {
			try {
				const s = await (await fetch(api('state'), { cache: 'no-store' })).json();
				questions = s.questions || []; current = s.current;
				drawList();
				const q = questions.find((x) => x.id === current);
				if (!q) {
					$('q-prompt').textContent = 'Voting has stopped';
					$('q-status').textContent = 'The next question will appear here.';
					$('chart').replaceChildren(); lastDrawn = '';
					return;
				}
				const r = await (await fetch(api(`results?q=${encodeURIComponent(q.id)}`), { cache: 'no-store' })).json();
				const key = JSON.stringify([q, r.count, r.counts, r.values, r.words]);
				if (key === lastDrawn) return;
				lastDrawn = key;
				$('q-prompt').textContent = q.prompt;
				const out = q.type === 'choice' ? drawChoice(q, r) : q.type === 'number' ? drawNumber(q, r) : drawText(q, r);
				$('chart').replaceChildren(out.node);
				$('q-status').textContent = out.status;
			} catch {
				$('q-status').textContent = 'Reconnecting…';
			}
		}

		// Presenter controls: only shown once the token has been accepted (checked by reading the presenter-only list).
		async function checkToken() {
			if (!token) { $('controls').hidden = true; return; }
			try {
				const res = await fetch(api('audience'), { headers: { 'x-presenter-token': token }, cache: 'no-store' });
				const ok = res.ok;
				$('token-status').textContent = ok ? 'Token accepted.' : res.status === 401 ? 'Wrong presenter token' : `The server said ${res.status}.`;
				$('token-status').className = ok ? 'good' : 'bad';
				$('controls').hidden = !ok;
			} catch { $('token-status').textContent = 'No connection just now.'; }
		}
		function drawList() {
			if ($('controls').hidden) return;
			const list = $('q-list');
			const sig = JSON.stringify([questions.map((q) => [q.id, q.prompt]), current]);
			if (list.dataset.sig === sig) return;
			list.dataset.sig = sig;
			list.replaceChildren(...questions.map((q) => {
				const li = el('li'), b = el('button', q.id === current ? 'q current' : 'q') as HTMLButtonElement;
				b.type = 'button';
				b.append(el('span', 'qid', q.id), el('span', 'qp', q.prompt));
				if (q.id === current) b.setAttribute('aria-current', 'true');
				b.addEventListener('click', () => { if (q.id !== current && confirm(`Show "${q.prompt}" on the phones?`)) post('current', { q: q.id }, 'Showing ' + q.id + '.'); });
				li.append(b);
				return li;
			}));
		}
		async function post(path: string, body: unknown, done: string) {
			$('control-status').textContent = 'Working…';
			try {
				const res = await fetch(api(path), { method: 'POST', headers: { 'content-type': 'application/json', 'x-presenter-token': token }, body: JSON.stringify({ set: setId, ...(body as object) }) });
				const data = await res.json().catch(() => ({}));
				$('control-status').textContent = res.ok ? done : res.status === 401 ? 'Wrong presenter token' : data.error || `The server said ${res.status}.`;
				lastDrawn = ''; refresh();
			} catch { $('control-status').textContent = 'No connection just now: try again.'; }
		}
		$('token-form').addEventListener('submit', (e) => { e.preventDefault(); token = ($<HTMLInputElement>('token')).value.trim(); store.put(STORE_KEY, token); checkToken().then(drawList); });
		$('stop').addEventListener('click', () => { if (confirm('Stop voting? The phones will show "waiting".')) post('current', { q: null }, 'Voting stopped.'); });
		$('clear').addEventListener('click', () => {
			if (!current) { $('control-status').textContent = 'No poll is showing: nothing to clear.'; return; }
			if (confirm(`Delete every answer to ${current}? This cannot be undone.`)) post('clear', { q: current }, `Cleared ${current}.`);
		});
		if (token) { ($<HTMLInputElement>('token')).value = token; checkToken(); }

		let timer = 0;
		const loop = async () => { await refresh(); if (!document.hidden) timer = window.setTimeout(loop, 2000); };
		document.addEventListener('visibilitychange', () => { clearTimeout(timer); if (!document.hidden) loop(); });
		loop();
	</script>

	<style is:global>
		@font-face { font-family: 'Montserrat SemiBold'; src: url('/fonts/Montserrat-SemiBold.woff2') format('woff2'); font-weight: 1 1000; font-display: swap; }
		:root { color-scheme: light; --blue: #007cbb; --green: #87bd25; --ink: #111; --muted: #555; }
		* { box-sizing: border-box; }
		body { margin: 0; background: #fff; color: var(--ink); font: 20px/1.4 'Montserrat SemiBold', Montserrat, Arial, Helvetica, sans-serif; }
		main { max-width: 72rem; margin: 0 auto; padding: 1rem clamp(1rem, 3vw, 2.5rem) 2rem; display: flex; flex-direction: column; gap: 1.25rem; min-height: 100dvh; }
		header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
		header img { display: block; height: clamp(2.6rem, 6vw, 4.5rem); width: auto; }
		.join { margin: 0; color: var(--muted); text-align: center; font-size: clamp(1rem, 2.4vw, 1.6rem); }
		.join strong { color: var(--blue); }
		.lecture { margin: 0; color: var(--blue); }
		h1 { font-size: clamp(1.6rem, 4.2vw, 3.2rem); line-height: 1.2; margin: 0; }
		.status { margin: 0.25rem 0 0; color: var(--muted); font-size: clamp(1.1rem, 2.6vw, 1.8rem); }
		#chart { margin-top: 1rem; }
		/* Choice: one row per option, the count on a swatch of the option's colour. One font size for every label. */
		.bars { display: flex; flex-direction: column; gap: 0.9rem; font-size: clamp(1.5rem, 3vw, 2.2rem); }
		.bar-row { display: grid; grid-template-columns: minmax(6rem, 30%) 1fr auto; align-items: center; gap: 0.75rem; }
		.bar-label { overflow-wrap: anywhere; }
		.bar-track { height: 2.2em; background: #f1f1f1; border-radius: 0.4rem; overflow: hidden; }
		.bar-fill { height: 100%; transition: width 0.5s ease; }
		.bar-count { min-width: 2.4em; text-align: center; border-radius: 0.4rem; padding: 0.2em 0.5em; font-variant-numeric: tabular-nums; }
		@media (prefers-reduced-motion: reduce) { .bar-fill { transition: none; } }
		.dots { width: 100%; height: auto; font-family: inherit; }
		.cloud { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; align-items: baseline; justify-content: center; line-height: 1.15; }
		/* The presenter's panel: small, at the foot, closed by default. */
		#presenter { margin-top: auto; border-top: 2px solid #e5e5e5; padding-top: 1rem; font-size: 1rem; }
		#presenter summary { cursor: pointer; color: var(--blue); }
		#presenter label { display: block; margin: 0.75rem 0 0.25rem; }
		.row { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; }
		#token { flex: 1 1 14rem; font: inherit; padding: 0.6rem; border: 2px solid #8a8a8a; border-radius: 0.4rem; }
		button { font: inherit; min-height: 2.75rem; padding: 0.5rem 1rem; border: 0; border-radius: 0.5rem; background: var(--blue); color: #fff; cursor: pointer; }
		button.secondary { background: #fff; color: var(--blue); border: 2px solid var(--blue); }
		button.danger { background: #b42318; }
		#q-list { list-style: none; padding: 0; margin: 0.5rem 0 1rem; display: grid; gap: 0.5rem; }
		button.q { width: 100%; text-align: left; display: flex; gap: 0.75rem; background: #fff; color: var(--ink); border: 2px solid #8a8a8a; }
		button.q.current { border-color: var(--blue); background: #e8f3fa; }
		.qid { color: #005f8f; min-width: 3.5rem; }
		.hint { color: var(--muted); margin: 0.5rem 0 0; }
		.good { color: #2f6b1a; } .bad { color: #b42318; font-weight: 700; }
		button:focus-visible, input:focus-visible, summary:focus-visible { outline: 3px solid var(--blue); outline-offset: 2px; }
		[hidden] { display: none !important; }
	</style>
</body>
</html>
