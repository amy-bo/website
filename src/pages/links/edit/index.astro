---
// The link-page editor. Static shell; everything happens in ../../../links/editor.ts against /api/links/*.
---
<!doctype html>
<html lang="en-GB">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
	<title>Edit your link page · AMYBO</title>
	<meta name="robots" content="noindex" />
	<meta name="color-scheme" content="light dark" />
	<link rel="icon" href="/favicon.svg" />
</head>
<body data-view="loading" data-pane="edit">
	<div id="v-loading" class="center"><div class="spinner" role="status"><span class="vh">Loading</span></div></div>

	<section id="v-signin" class="center" hidden>
		<div class="card narrow">
			<img src="/link-media/amybo.svg" alt="AMYBO" class="brand" width="120" height="83" />
			<h1>Your link page</h1>
			<p class="muted">Enter the email address your invitation went to, and we'll send you a link to sign in. No password needed.</p>
			<form id="signin-form">
				<label class="field"><span>Email</span><input id="signin-email" type="email" autocomplete="email" required placeholder="you@example.org" /></label>
				<button class="primary wide">Email me a sign-in link</button>
			</form>
			<p id="signin-msg" class="msg" role="status"></p>
			<p class="fine">Link pages are by invitation for AMYBO volunteers and supporters. Would you like one? <a href="https://amybo.org/contact/">Get in touch</a>.</p>
		</div>
	</section>

	<section id="v-sent" class="center" hidden>
		<div class="card narrow">
			<div class="big" aria-hidden="true">✉️</div>
			<h1>Check your email</h1>
			<p class="muted">If <b id="sent-to"></b> has a link page, a sign-in link is on its way. It works once, for 20 minutes. It can take a minute or two to arrive; check junk or spam if it doesn't.</p>
			<button id="sent-again" class="ghost">Use a different address</button>
		</div>
	</section>

	<div id="v-editor" hidden>
		<header class="bar">
			<a href="https://amybo.org/" class="home"><img src="/link-media/amybo.svg" alt="AMYBO" width="58" height="40" /></a>
			<div class="addr"><span id="addr"></span><button id="copy" class="icon-btn" aria-label="Copy the address"><svg viewBox="0 0 24 24"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/></svg></button></div>
			<span id="savestate" class="savestate" role="status" aria-live="polite"></span>
			<a id="view" class="ghost small" target="_blank" rel="noopener">View page</a>
		</header>
		<nav class="panes" aria-label="Show">
			<button data-pane="edit" aria-pressed="true">Edit</button><button data-pane="preview" aria-pressed="false">Preview</button>
		</nav>
		<main class="work">
			<div class="editpane">
				<section class="card" aria-labelledby="h-profile">
					<h2 id="h-profile" class="vh">You</h2>
					<div class="profile">
						<button id="p-photo" class="photo" aria-label="Change your photo"></button>
						<input id="p-file" type="file" accept="image/*" hidden />
						<div class="pfields">
							<label class="field"><span>Name</span><input id="p-name" maxlength="80" autocomplete="name" /></label>
							<label class="field"><span>About you <em id="p-count"></em></span><textarea id="p-bio" rows="2" maxlength="300" placeholder="A line about you and your work"></textarea></label>
						</div>
					</div>
					<p id="upload-note" class="fine" hidden>Photo and picture uploads will be switched on soon. Until then, choose from the icons.</p>
				</section>

				<section class="card" aria-labelledby="h-links">
					<div class="cardhead"><h2 id="h-links">Links</h2><span class="fine">Drag to reorder, or use ⋯</span></div>
					<ul id="tree" class="tree"></ul>
					<div class="adds">
						<button id="add-link" class="primary">+ Add a link</button>
						<button id="add-group" class="ghost">+ Group</button>
						<button id="add-diary" class="ghost">+ Diary</button>
						<button id="add-support" class="ghost">+ How I support</button>
					</div>
				</section>

				<section class="card" id="diary-card" aria-labelledby="h-diary" hidden>
					<div class="cardhead"><h2 id="h-diary">Diary</h2><button id="new-entry" class="primary small">+ New entry</button></div>
					<p class="fine">Write up what you're working on for AMYBO, as briefly or fully as you like. Star the entries you're proudest of: visitors can choose to see just those.</p>
					<ul id="entries" class="entries"></ul>
					<fieldset class="seg">
						<legend>Visitors first see</legend>
						<label><input type="radio" name="ddef" value="all" /> All entries</label>
						<label><input type="radio" name="ddef" value="highlights" /> Highlights</label>
					</fieldset>
				</section>

				<section class="card" aria-labelledby="h-settings">
					<h2 id="h-settings">Settings</h2>
					<label class="switch"><input id="s-map" type="checkbox" /><span class="track" aria-hidden="true"></span><span>Show the map of your links beside the list</span></label>
					<p class="fine">Signed in as <span id="who"></span>. <button id="signout" class="link">Sign out</button></p>
				</section>
			</div>
			<div class="previewpane">
				<div class="device"><iframe id="preview" title="Preview of your page"></iframe></div>
			</div>
		</main>
	</div>

	<dialog id="adder" aria-labelledby="adder-title">
		<form id="a-form" method="dialog">
			<h2 id="adder-title">Add a link</h2>
			<label class="field"><span>Web address</span><input id="a-url" inputmode="url" autocomplete="url" spellcheck="false" placeholder="Paste a link, e.g. youtube.com/@you" required /></label>
			<div class="arow"><button type="button" id="a-tile" class="tile big-tile" aria-label="Choose a picture"></button><label class="field grow"><span>Name</span><input id="a-name" placeholder="What people will see" /></label></div>
			<p id="a-hint" class="fine"></p>
			<div class="actions"><button type="button" id="a-cancel" class="ghost">Cancel</button><button class="primary">Add</button></div>
		</form>
	</dialog>

	<dialog id="picker" aria-labelledby="picker-title">
		<div class="pickhead"><h2 id="picker-title">Picture</h2><button type="button" id="pick-close" class="icon-btn" aria-label="Close"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div>
		<div id="suggested" class="suggested"></div>
		<label id="pick-upload" class="uploadbtn"><input id="pick-file" type="file" accept="image/*" /> Upload your own</label>
		<input id="icon-search" type="search" placeholder="Search icons" aria-label="Search icons" />
		<div id="icon-grid" class="grid"></div>
	</dialog>

	<dialog id="entry" aria-labelledby="entry-title">
		<form id="e-form" method="dialog">
			<h2 id="entry-title">New diary entry</h2>
			<div class="arow"><label class="field"><span>Date</span><input id="e-day" type="date" required /></label><label class="hl-toggle"><input id="e-hl" type="checkbox" /> ★ Highlight</label></div>
			<label class="field"><span>Title</span><input id="e-title" maxlength="160" required placeholder="e.g. First anode test on the AEP 0.2" /></label>
			<label class="field"><span>What happened</span><textarea id="e-body" rows="9" placeholder="Links work as they are, or [like this](https://…). **Bold** and *italic* too."></textarea></label>
			<div class="actions"><button type="button" id="e-delete" class="danger ghost">Delete</button><span class="grow"></span><button type="button" id="e-cancel" class="ghost">Cancel</button><button class="primary">Save entry</button></div>
		</form>
	</dialog>

	<div id="toasts" class="toasts"></div>
	<script>
		import '../../../links/editor';
	</script>
</body>
</html>

<style is:global>
	:root{--bg:#f4f7f1;--card:#fff;--ink:#132010;--muted:#5d6c56;--line:#dce6d4;--accent:#3f9c00;--accent-ink:#175a00;--tile:#eef4e8;--danger:#b42318;--shadow:0 1px 2px rgb(19 32 16/5%),0 8px 24px rgb(19 32 16/7%);--ease:cubic-bezier(.2,.8,.2,1)}
	@media (prefers-color-scheme:dark){:root{--bg:#0b1208;--card:#141f10;--ink:#e9f2e3;--muted:#9bad92;--line:#22331b;--accent:#87bd25;--accent-ink:#b7e27c;--tile:#1c2b16;--danger:#ff8a80;--shadow:0 1px 2px rgb(0 0 0/40%)}img.brand,.home img{filter:invert(1) hue-rotate(180deg) brightness(1.1)}}
	*{box-sizing:border-box}
	html{background:var(--bg)}
	body{margin:0;font:15px/1.45 system-ui,-apple-system,"SF Pro Text","Segoe UI",Roboto,Helvetica,Arial,sans-serif;color:var(--ink);-webkit-font-smoothing:antialiased}
	[hidden]{display:none!important}
	.vh{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
	a{color:var(--accent-ink)}
	h1{font-size:1.6rem;letter-spacing:-.015em;margin:.2rem 0 .5rem}
	h2{font-size:1rem;margin:0 0 .8rem;letter-spacing:-.005em}
	.muted{color:var(--muted)}
	.fine{font-size:.82rem;color:var(--muted);margin:.6rem 0 0}
	.center{min-height:100vh;display:grid;place-items:center;padding:1.5rem}
	.card{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:1.3rem;box-shadow:var(--shadow)}
	.narrow{max-width:26rem;width:100%;text-align:center}
	.brand{display:block;margin:0 auto 1rem;height:auto}
	.big{font-size:2.6rem}
	.spinner{width:28px;height:28px;border-radius:50%;border:3px solid var(--line);border-top-color:var(--accent);animation:spin .8s linear infinite}
	@keyframes spin{to{transform:rotate(1turn)}}
	.field{display:grid;gap:.3rem;text-align:left;margin:.7rem 0}
	.field>span{font-size:.8rem;font-weight:600;color:var(--muted);display:flex;justify-content:space-between}
	.field em{font-style:normal;font-weight:500}
	input,textarea,select{font:inherit;color:inherit;background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:.6rem .75rem;width:100%;transition:border-color .15s,box-shadow .15s}
	input:focus,textarea:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 22%,transparent)}
	textarea{resize:vertical}
	button{font:inherit;cursor:pointer;color:inherit}
	.primary{background:var(--accent-ink);color:#fff;border:0;border-radius:999px;padding:.6rem 1.15rem;font-weight:600;transition:transform .15s var(--ease),filter .15s}
	@media (prefers-color-scheme:dark){.primary{background:var(--accent);color:#0b1208}}
	.primary:hover{filter:brightness(1.08)}.primary:active{transform:scale(.97)}
	.primary:disabled{opacity:.6}
	.wide{width:100%;margin-top:.4rem}
	.ghost{background:transparent;border:1px solid var(--line);border-radius:999px;padding:.5rem 1rem;font-weight:550;color:var(--ink);text-decoration:none}
	.ghost:hover{border-color:var(--accent)}
	.small{padding:.35rem .8rem;font-size:.85rem}
	.danger{color:var(--danger)}
	.link{background:none;border:0;padding:0;color:var(--accent-ink);text-decoration:underline;font-size:inherit}
	.icon-btn{background:none;border:0;padding:.3rem;border-radius:8px;color:var(--muted);display:inline-grid;place-items:center}
	.icon-btn svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
	.icon-btn:hover{background:var(--tile);color:var(--ink)}
	.msg{min-height:1.3em;color:var(--danger);font-size:.9rem}
	/* editor layout */
	.bar{position:sticky;top:0;z-index:10;display:flex;align-items:center;gap:1rem;padding:.7rem max(1rem,env(safe-area-inset-left));background:color-mix(in srgb,var(--bg) 82%,transparent);backdrop-filter:saturate(1.6) blur(14px);-webkit-backdrop-filter:saturate(1.6) blur(14px);border-bottom:1px solid var(--line)}
	.home img{display:block;height:28px;width:auto}
	.addr{display:flex;align-items:center;gap:.2rem;font-weight:650;min-width:0}
	.addr span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
	.savestate{margin-left:auto;font-size:.8rem;color:var(--muted);white-space:nowrap}
	.savestate.ok::before{content:"✓ ";color:var(--accent)}
	.savestate.err{color:var(--danger)}
	.panes{display:none}
	.work{display:grid;grid-template-columns:minmax(0,38rem) minmax(22rem,1fr);gap:2rem;max-width:84rem;margin:0 auto;padding:1.5rem 1rem 4rem}
	.editpane{display:grid;gap:1.1rem;align-content:start}
	.previewpane{position:sticky;top:5rem;align-self:start;height:calc(100vh - 6.5rem)}
	.device{height:100%;border-radius:28px;overflow:hidden;border:1px solid var(--line);box-shadow:var(--shadow);background:var(--bg)}
	.device iframe{width:100%;height:100%;border:0;display:block}
	@media (max-width:60rem){.work{grid-template-columns:minmax(0,1fr)}.panes{display:flex;justify-content:center;gap:.25rem;margin:.8rem auto 0;padding:.25rem;width:max-content;border-radius:999px;background:var(--tile)}.panes button{border:0;background:none;border-radius:999px;padding:.35rem 1.2rem;font-weight:600;color:var(--muted)}.panes button[aria-pressed=true]{background:var(--card);color:var(--ink);box-shadow:var(--shadow)}body[data-pane=edit] .previewpane{display:none}body[data-pane=preview] .editpane{display:none}.previewpane{position:static;height:calc(100vh - 9rem)}}
	.cardhead{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;margin-bottom:.4rem}
	.cardhead h2{margin:0}
	.profile{display:flex;gap:1.1rem;align-items:center}
	.photo{flex:none;width:5.5rem;height:5.5rem;border-radius:50%;border:0;padding:0;overflow:hidden;background:linear-gradient(135deg,#87bd25,#175a00);color:#fff;font-size:1.7rem;font-weight:700;display:grid;place-items:center;position:relative;box-shadow:0 0 0 3px var(--card),0 0 0 4px var(--line)}
	.photo img{width:100%;height:100%;object-fit:cover}
	.photo.logo{border-radius:16px;background:var(--card)}
	.photo.logo img{object-fit:contain;padding:.4rem}
	.photo::after{content:"Change";position:absolute;inset:auto 0 0;font-size:.65rem;font-weight:600;padding:.25rem 0 .35rem;background:rgb(0 0 0/45%);opacity:0;transition:opacity .2s}
	.photo:hover::after,.photo:focus-visible::after{opacity:1}
	.pfields{flex:1;min-width:0}
	.pfields .field{margin:.2rem 0 .5rem}
	/* tree */
	.tree,.kids{list-style:none;margin:0;padding:0;display:grid;gap:.45rem}
	.kids{margin:.45rem 0 0 1.4rem;padding-left:.7rem;border-left:1.5px solid var(--line)}
	.row .rowin{display:flex;align-items:center;gap:.55rem;padding:.45rem .5rem .45rem .3rem;border:1px solid var(--line);border-radius:16px;background:var(--card);transition:box-shadow .15s,border-color .15s,opacity .15s}
	.row .rowin:focus-within{border-color:color-mix(in srgb,var(--accent) 55%,var(--line))}
	.row.group>.rowin{background:var(--tile);border-color:transparent}
	.row.dragging>.rowin{opacity:.35}
	.drop-before{box-shadow:0 -3px 0 var(--accent)}
	.drop-after{box-shadow:0 3px 0 var(--accent)}
	.drop-in{border-color:var(--accent)!important;box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 25%,transparent)}
	.grip{flex:none;width:18px;height:28px;display:grid;place-items:center;cursor:grab;color:var(--muted);opacity:.55}
	.grip svg{width:16px;height:16px;fill:currentColor}
	.rowin:hover .grip{opacity:1}
	.tw{flex:none;width:22px;height:22px;border:0;background:none;padding:0;display:grid;place-items:center}
	.tw::before{content:"";width:7px;height:7px;border-right:2px solid var(--muted);border-bottom:2px solid var(--muted);transform:rotate(-45deg);transition:transform .2s var(--ease)}
	.tw.open::before{transform:rotate(45deg)}
	.tile{flex:none;width:2.6rem;height:2.6rem;border-radius:12px;border:1px solid transparent;background:var(--tile);display:grid;place-items:center;padding:0;overflow:hidden;color:var(--accent-ink);transition:border-color .15s}
	.tile:hover{border-color:var(--accent)}
	.tile img{width:100%;height:100%;object-fit:cover}
	.tile svg,.ichoice svg,.sugg svg{width:1.35rem;height:1.35rem}
	svg.ib{fill:var(--brand,currentColor)}
	@media (prefers-color-scheme:dark){svg.ib{fill:currentColor}}
	svg.il{fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
	.fields{flex:1;min-width:0;display:grid}
	.fields input,.fields textarea{background:transparent;border-color:transparent;padding:.15rem .4rem;border-radius:8px}
	.fields input:hover,.fields textarea:hover{border-color:var(--line)}
	.fields .lbl{font-weight:600}
	.row.group .lbl{font-size:.8rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
	.fields .url{font-size:.82rem;color:var(--muted)}
	.fields .body{margin-top:.3rem;background:var(--bg);border-color:var(--line);font-size:.9rem}
	.sub{font-size:.8rem;color:var(--muted);padding:0 .4rem}
	.chip{flex:none;font-size:.72rem;font-weight:600;color:var(--muted);background:var(--tile);border-radius:99px;padding:.1rem .5rem;white-space:nowrap}
	.row.group .chip{background:var(--card)}
	.more{flex:none;width:30px;height:30px;border:0;background:none;border-radius:8px;display:grid;place-items:center;color:var(--muted)}
	.more svg{width:18px;height:18px;fill:currentColor}
	.more:hover{background:var(--tile);color:var(--ink)}
	.addin{padding-left:.2rem}
	.addin .ghost{font-size:.82rem;padding:.3rem .7rem;border-style:dashed}
	.empty{color:var(--muted);text-align:center;padding:1rem;font-size:.9rem}
	.adds{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1rem}
	.menu{position:absolute;z-index:30;min-width:13rem;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:.35rem;box-shadow:0 12px 40px rgb(0 0 0/18%);display:grid;animation:pop .14s var(--ease)}
	.menu button{text-align:left;background:none;border:0;border-radius:9px;padding:.5rem .7rem}
	.menu button:hover,.menu button:focus-visible{background:var(--tile);outline:none}
	@keyframes pop{from{opacity:0;transform:translateY(-4px) scale(.98)}}
	/* diary */
	.entries{list-style:none;margin:.8rem 0;padding:0;display:grid;gap:.4rem}
	.entry{display:flex;align-items:center;gap:.6rem;padding:.5rem .6rem;border:1px solid var(--line);border-radius:14px}
	.entry.hl{border-color:color-mix(in srgb,var(--accent) 50%,var(--line))}
	.star{border:0;background:none;font-size:1.2rem;color:var(--accent);width:2rem;height:2rem;border-radius:8px}
	.star:hover{background:var(--tile)}
	.etext{flex:1;min-width:0;display:grid}
	.eday{font-size:.75rem;color:var(--muted)}
	.etitle{font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
	.seg{border:0;padding:0;margin:.6rem 0 0;display:flex;gap:1rem;flex-wrap:wrap;align-items:center;font-size:.9rem}
	.seg legend{float:left;font-weight:600;font-size:.8rem;color:var(--muted);margin-right:.4rem}
	.seg input,.switch input,.hl-toggle input{width:auto}
	/* switch */
	.switch{display:flex;align-items:center;gap:.7rem;cursor:pointer}
	.switch input{position:absolute;opacity:0}
	.track{flex:none;width:44px;height:26px;border-radius:99px;background:var(--line);position:relative;transition:background .2s}
	.track::after{content:"";position:absolute;top:3px;left:3px;width:20px;height:20px;border-radius:50%;background:#fff;box-shadow:0 1px 3px rgb(0 0 0/25%);transition:transform .2s var(--ease)}
	.switch input:checked+.track{background:var(--accent)}
	.switch input:checked+.track::after{transform:translateX(18px)}
	.switch input:focus-visible+.track{outline:3px solid var(--accent);outline-offset:2px}
	/* dialogs */
	dialog{border:0;border-radius:22px;padding:1.3rem;width:min(30rem,calc(100vw - 2rem));background:var(--card);color:var(--ink);box-shadow:0 30px 80px rgb(0 0 0/30%)}
	dialog::backdrop{background:rgb(10 20 8/35%);backdrop-filter:blur(3px)}
	dialog[open]{animation:pop .18s var(--ease)}
	dialog h2{font-size:1.15rem}
	.arow{display:flex;gap:.8rem;align-items:end}
	.grow{flex:1}
	.big-tile{width:3.2rem;height:3.2rem;margin-bottom:.75rem}
	.actions{display:flex;gap:.5rem;justify-content:flex-end;margin-top:1rem}
	.hl-toggle{display:flex;gap:.4rem;align-items:center;margin-bottom:1rem;font-weight:600;color:var(--accent-ink)}
	.pickhead{display:flex;justify-content:space-between;align-items:center}
	.suggested{display:flex;gap:.5rem;flex-wrap:wrap;margin:.2rem 0 .8rem}
	.sugg{display:flex;align-items:center;gap:.5rem;padding:.35rem .7rem .35rem .35rem;border:1px solid var(--line);border-radius:14px;background:var(--bg);font-size:.85rem}
	.sugg img{width:2.2rem;height:2.2rem;border-radius:9px;object-fit:cover}
	.sugg:hover{border-color:var(--accent)}
	.sugg.busy{opacity:.5}
	.uploadbtn{display:inline-block;margin-bottom:.8rem;font-size:.85rem;font-weight:600;color:var(--accent-ink);cursor:pointer}
	.uploadbtn input{width:auto;padding:0;border:0;background:none;font-size:.8rem}
	.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(2.8rem,1fr));gap:.4rem;max-height:16rem;overflow:auto;margin-top:.7rem;padding:.1rem}
	.ichoice{aspect-ratio:1;border:1px solid transparent;border-radius:12px;background:var(--tile);display:grid;place-items:center;color:var(--accent-ink)}
	.ichoice:hover,.ichoice.on{border-color:var(--accent)}
	/* toasts */
	.toasts{position:fixed;left:50%;bottom:max(1.2rem,env(safe-area-inset-bottom));transform:translateX(-50%);display:grid;gap:.5rem;z-index:50;pointer-events:none}
	.toast{background:var(--ink);color:var(--bg);padding:.6rem 1.1rem;border-radius:999px;font-weight:550;font-size:.9rem;box-shadow:var(--shadow);animation:pop .2s var(--ease);transition:opacity .35s,transform .35s}
